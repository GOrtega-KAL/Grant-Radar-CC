grant_radar_data/source_document_cache.json
grant_radar_data/source_document_cache.json.tmp

# Credenciales reales (nunca deben llegar a git) — ver .env.example
API KEYs.txt
.env

# Registros y salidas generadas, no código fuente
debug.log
convocatorias.json

# Entorno Python local y cachés de bytecode
.venv/
__pycache__/
*.pyc

# Registros de las recopilaciones lanzadas con "Grant-Radar diario.bat /log".
# Son para diagnosticar una ejecucion concreta; el historial que importa vive
# en grant_radar_data/grant_radar_audit.json, que si se versiona.
grant_radar_data/logs/

# Del Worker de favoritos: estado local de wrangler y dependencias de npm.
# El Worker no tiene dependencias —por eso `npm install` no hace falta— pero
# si alguien lo ejecuta, esto evita que acaben versionadas.
scripts/favoritos-worker/node_modules/
scripts/favoritos-worker/.wrangler/

# Estado del lote diferido: es local y efímero —identificador de un lote
# concreto y las convocatorias que lleva dentro—, y no describe el producto.
grant_radar_data/batch_state.json
